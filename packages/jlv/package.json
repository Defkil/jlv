{
  "name": "jlv",
  "version": "2.0.0",
  "description": "Terminal viewer for JSON and other structured logs from files, globs and pipes: pino, bunyan, Winston, logfmt, CSV and Docker",
  "keywords": [
    "log",
    "logs",
    "log-viewer",
    "json",
    "jsonl",
    "ndjson",
    "pino",
    "bunyan",
    "winston",
    "logfmt",
    "csv",
    "docker",
    "terminal",
    "tui",
    "cli"
  ],
  "homepage": "https://github.com/Defkil/jlv/tree/master/packages/jlv#readme",
  "bugs": {
    "url": "https://github.com/Defkil/jlv/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Defkil/jlv.git",
    "directory": "packages/jlv"
  },
  "license": "MIT",
  "author": "Oliver Grüttner <mail@olivergruettner.de>",
  "contributors": [
    "Felipe Coury"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "bin": {
    "jlv": "./dist/cli.js"
  },
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "default": "./dist/formats/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "ini": "6.0.0",
    "neo-blessed": "0.2.0",
    "tinyglobby": "0.2.17"
  },
  "devDependencies": {
    "@types/blessed": "0.1.27",
    "@types/ini": "4.1.1",
    "@types/picomatch": "4.0.3"
  }
}
